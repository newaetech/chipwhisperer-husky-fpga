    <Run Id="impl_1" Type="Ft2:EntireDesign" Part="xc7a100tftg256-3" ConstrsSet="constrs_100" Description="Combines retiming in phys_opt_design with extra placement optimization and higher router delay cost." AutoIncrementalCheckpoint="false" WriteIncrSynthDcp="false" State="current" Dir="$PRUNDIR/impl_1" SynthRun="synth_1" IncludeInArchive="true" IsChild="false" GenFullBitstream="true" AutoIncrementalDir="$PPRDIR/../../../cw_husky_clean2/fpga/vivado/cwhusky_plus.srcs/utils_1/imports/impl_1" AutoRQSDir="$PPRDIR/../../../cw_husky_clean2/fpga/vivado/cwhusky_plus.srcs/utils_1/imports/impl_1">
